# Resend API Key — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email destinatario per il form di contatto
CONTACT_EMAIL_TO=your_email@example.com

# Mittente email (deve essere un indirizzo sul dominio verificato su Resend)
RESEND_FROM=Portfolio <noreply@email.yourdomain.com>

# Vercel Analytics — abilita in Production/Preview, lascia false in locale
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Vercel Speed Insights — abilita in Production/Preview, lascia false in locale
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=false

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# In locale non serve: senza chiavi vengono usate quelle di test di Cloudflare.
# In produzione TURNSTILE_SECRET_KEY è obbligatoria: senza, il form rifiuta gli invii.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Banner "sito in costruzione" (default: false)
NEXT_PUBLIC_SHOW_BANNER=false

# Data di aggiornamento mostrata sul pulsante del CV (default: 06/07/2026)
NEXT_PUBLIC_CV_UPDATED_AT=06/07/2026
