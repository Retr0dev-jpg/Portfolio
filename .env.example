# Resend API Key — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email destinatario per il form di contatto
CONTACT_EMAIL_TO=your_email@example.com

# Mittente email (deve essere un indirizzo sul dominio verificato su Resend)
RESEND_FROM=Portfolio <noreply@email.yourdomain.com>
